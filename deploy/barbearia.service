[Unit]
Description=Barbearia (Flask + gunicorn)
After=network.target

[Service]
User=__USER__
WorkingDirectory=/opt/barbearia
EnvironmentFile=/opt/barbearia/.env
ExecStart=/opt/barbearia/venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:8000 --timeout 120 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

