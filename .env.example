ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
DB_PATH=barbearia.db
DEFAULT_RETURN_DAYS=21

# --- Backup (automático todo dia às 03:30; também dá para baixar pelo painel) ---
# BACKUP_DIR=/caminho/para/backups
# BACKUP_KEEP_DAYS=14
# Backup na nuvem via rclone (Google Drive, Dropbox, Backblaze...). Configure o rclone no servidor e informe destino:pasta
# RCLONE_REMOTE=gdrive:barbearia-backups
# REMOTE_KEEP_DAYS=60     # quanto tempo manter as cópias na nuvem

# --- Dados da barbearia (valores PADRÃO; o painel, aba Site, sobrescreve sem mexer no servidor) ---
# SHOP_NAME=D.Lourenço Barbearia
# SHOP_SHORT_NAME=D.Lourenço
# SHOP_BRAND=00            # monograma do logo do site (cabeçalho, título da equipe e rodapé)
# SHOP_ADDRESS=Av. Mal. Argôlo, 912, Vila Passos, Lorena - SP, 12604-440
# SHOP_WHATSAPP=12999999999
# SHOP_INSTAGRAM=@minhabarbearia
# SHOP_TAGLINE=Barbearia em Lorena-SP. Agende online: cortes, barba e produtos.

# --- Cliente: cancelar/remarcar por link e lembretes ---
# PUBLIC_URL=https://minhabarbearia.duckdns.org   # usado nos links enviados por WhatsApp (obrigatório para o link aparecer na mensagem)
# CHANGE_DEADLINE_HOURS=2   # até quantas horas antes o cliente pode cancelar/remarcar
# MAX_RESCHEDULES=3         # remarcações por agendamento
# DAY_BEFORE_HOUR=18        # hora do lembrete da véspera

# --- Segurança do painel ---
# ADMIN_MAX_FAILS=8   # senhas DIFERENTES erradas por IP...
# ADMIN_LOCK_MIN=15   # ...dentro desta janela (min) bloqueiam o IP até a janela passar

# --- Privacidade (LGPD) ---
# PRIVACY_CONTACT=privacidade@minhabarbearia.com.br   # contato exibido na Política de Privacidade (e-mail ou WhatsApp)
# RETENTION_MONTHS=24   # anonimiza clientes sem atendimento há N meses (0 = desligado)

# --- Monitoramento e alertas ---
# ALERT_NTFY_URL=https://ntfy.sh/escolha-um-nome-dificil-de-adivinhar   # avisos no celular (app ntfy, grátis)
# WA_ALERT_MINUTES=10   # minutos com o WhatsApp desconectado até alertar

# --- Anti-spam do agendamento ---
# BOOK_PER_IP_HOUR=10     # tentativas por IP por hora
# MAX_OPEN_PER_PHONE=2    # horários futuros por WhatsApp
# MAX_DAYS_AHEAD=30       # até quantos dias à frente se pode marcar
# PROXY_HOPS=1            # 1 = atrás do Caddy/Nginx (IP real do cliente); 0 = sem proxy

# --- Google Agenda (conta de serviço) ---
# Compartilhe a agenda de cada barbeiro com o e-mail da conta (permissão "Fazer alterações")
# e cadastre o ID da agenda no painel (aba Cadastros > Barbeiros). Use um dos dois:
# GOOGLE_SA_FILE=/caminho/google-sa.json
# GOOGLE_SA_JSON={"type":"service_account",...}   # JSON inteiro em uma linha

# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN=
WA_PHONE_ID=
# --- WhatsApp NÃO OFICIAL (gateway Baileys em ./wa-gateway) – use o mesmo segredo nos dois processos ---
WA_GATEWAY_URL=http://127.0.0.1:3001
WA_GATEWAY_SECRET=gere-um-segredo-longo
# Apresentação: 1 = simula o WhatsApp (caixa de saída no /admin, nada é enviado de verdade)
WA_DEMO=0
