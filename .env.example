# --- Planilhas e Agenda do Google (obrigatórios) ---
SHEET_FINANCEIRO_ID=id-da-planilha-financeira   # trecho entre /d/ e /edit na URL (guarda também o cadastro: serviços, horários...)
SHEET_ESTOQUE_ID=id-da-planilha-de-estoque
# SHEET_CADASTRO_ID=                              # opcional: cadastro em uma 3ª planilha (padrão: a financeira)
CALENDAR_ID=id-da-agenda                          # Agenda > Configurações da agenda > "ID da agenda" (agenda padrão de todos os barbeiros)
# SYNC_MINUTES=10   # só fora da Vercel (rodando local/VPS): intervalo da sincronização; na Vercel quem sincroniza é o cron diário
# Credenciais da conta de serviço: use UMA das duas opções
GOOGLE_SA_FILE=credenciais-google.json     # caminho do arquivo .json (nunca suba para o GitHub)
# GOOGLE_SA_JSON={"type":"service_account",...}   # ou o JSON inteiro em uma linha (bom para Render/Fly/Docker)

# --- Site ---
PUBLIC_URL=https://minhabarbearia.duckdns.org   # usado nos links de cancelar/remarcar
PRIVACY_CONTACT=seuemail@exemplo.com            # aparece na Política de Privacidade
PROXY_HOPS=1                                    # 1 = atrás de Caddy/Nginx/Fly; 0 = sem proxy

# --- Regras de agendamento (valores padrão) ---
# MAX_DAYS_AHEAD=30
# MAX_OPEN_PER_PHONE=2
# BOOK_PER_IP_HOUR=10
# CHANGE_DEADLINE_HOURS=2
# MAX_RESCHEDULES=3

# --- Segurança (obrigatórias na Vercel: Settings > Environment Variables) ---
ADMIN_PASSWORD=troque-por-uma-senha-longa        # senha do /login (sem ela ninguém entra no painel)
SECRET_KEY=gere-com-python-c-"import secrets;print(secrets.token_hex(32))"   # assina o cookie de login
CRON_SECRET=gere-outro-valor-aleatorio           # a Vercel envia "Authorization: Bearer <CRON_SECRET>" no cron diário
# Na Vercel use GOOGLE_SA_JSON (o JSON inteiro em uma linha); GOOGLE_SA_FILE não existe lá.
